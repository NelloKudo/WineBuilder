From 7d6d20ec731dddfee4de6eaaeddebca28795ec60 Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Tue, 8 Sep 2026 01:37:56 +0200
Subject: [PATCH] winealsa.drv: Allow forcing the audio buffer size with
 WINE_AUDIO_PERIOD_NUM.

e.g. WINE_AUDIO_PERIOD_NUM=8
---
 dlls/winealsa.drv/alsa.c | 32 +++++++++++++++++++++++++++++---
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/dlls/winealsa.drv/alsa.c b/dlls/winealsa.drv/alsa.c
index 10880146ff9..6e7ae2e85f4 100644
--- a/dlls/winealsa.drv/alsa.c
+++ b/dlls/winealsa.drv/alsa.c
@@ -484,6 +484,29 @@ static const char *alsa_default_name(void)
     return name && name[0] ? name : "default";
 }
 
+static unsigned int alsa_period_num(unsigned int def)
+{
+    static unsigned int periods;
+    static BOOL parsed;
+
+    if(!parsed){
+        const char *env = getenv("WINE_AUDIO_PERIOD_NUM");
+
+        parsed = TRUE;
+
+        if(env && env[0]){
+            char *end;
+            unsigned int val = strtoul(env, &end, 10);
+
+            if(val >= 2 && *end == '\0') periods = val;
+            if(periods) MESSAGE("Forcing an audio buffer of %u periods\n", periods);
+            else MESSAGE("Invalid WINE_AUDIO_PERIOD_NUM value \"%s\", expected at least 2 periods\n", env);
+        }
+    }
+
+    return periods ? periods : def;
+}
+
 static NTSTATUS alsa_get_endpoint_ids(void *args)
 {
     static const WCHAR defaultW[] = {'d','e','f','a','u','l','t',0};
@@ -896,12 +919,12 @@ static NTSTATUS alsa_create_stream(void *args)
     }
 
     /* Buffer 4 ALSA periods if large enough, else 4 mmdevapi periods */
-    stream->alsa_bufsize_frames = stream->mmdev_period_frames * 4;
+    stream->alsa_bufsize_frames = stream->mmdev_period_frames * alsa_period_num(4);
     if(err < 0 || alsa_period_us < params->period / 10)
         err = snd_pcm_hw_params_set_buffer_size_near(stream->pcm_handle,
                 stream->hw_params, &stream->alsa_bufsize_frames);
     else{
-        unsigned int periods = 4;
+        unsigned int periods = alsa_period_num(4);
         err = snd_pcm_hw_params_set_periods_near(stream->pcm_handle, stream->hw_params, &periods, NULL);
     }
     if(err < 0)
@@ -971,7 +994,10 @@ static NTSTATUS alsa_create_stream(void *args)
      * or surprising rounding as seen with 22050x8x1 with Pulse:
      * ALSA period 220 vs.  221 frames in mmdevapi and
      *      buffer 883 vs. 2205 frames in mmdevapi! */
-    stream->bufsize_frames = muldiv(params->duration, params->fmt->nSamplesPerSec, 10000000);
+    if(alsa_period_num(0))
+        stream->bufsize_frames = max(stream->alsa_bufsize_frames, stream->mmdev_period_frames * 2);
+    else
+        stream->bufsize_frames = muldiv(params->duration, params->fmt->nSamplesPerSec, 10000000);
     if(params->share == AUDCLNT_SHAREMODE_EXCLUSIVE)
         stream->bufsize_frames -= stream->bufsize_frames % stream->mmdev_period_frames;
     stream->hidden_frames = stream->alsa_period_frames + stream->mmdev_period_frames +
-- 
2.55.0

